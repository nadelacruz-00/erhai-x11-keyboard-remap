<?xml version="1.0" encoding="utf-8"?>
<!--
  One master switch, a status summary, and a reboot action.

  The per-app list was removed deliberately: the keymap layer is global and static, so a per-app
  list implied granularity that could only ever be partly true. Everything here is applied by a
  reboot, which is also what makes "off" a true no-op rather than an un-doing.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!--
      No top app bar: the screen has one job, and the status card's heading already states what
      state the remap is in, so a title bar showing the app name was just repeating information
      the user already had when they opened it.

      fitsSystemWindows replaces the one useful thing the toolbar was doing - keeping content out
      from under the system bars. That matters here because targetSdk 35 is edge-to-edge by
      default, so without it the card would draw underneath the status bar.
    -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_margin"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/gap_l">

        <TextView
            android:id="@+id/permWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_m"
            android:background="#4A3A00"
            android:padding="@dimen/row_padding_v"
            android:text="@string/permission_missing"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="#FFD54F"
            android:visibility="gone" />

        <!-- Status: what is actually in effect -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_xl"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/gap_l">

                <TextView
                    android:id="@+id/stateTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/state_off"
                    android:textAppearance="?attr/textAppearanceHeadlineSmall" />

                <TextView
                    android:id="@+id/stateDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_s"
                    android:alpha="0.85"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <TextView
                    android:id="@+id/pending"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_m"
                    android:text="@string/pending"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorPrimary"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- The switch -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_l"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="72dp"
                android:orientation="horizontal"
                android:paddingStart="@dimen/gap_l"
                android:paddingEnd="@dimen/gap_l">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/gap_m">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/switch_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/switch_sub"
                        android:textAppearance="?attr/textAppearanceBodySmall" />
                </LinearLayout>

                <Switch
                    android:id="@+id/swEnabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/rootNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_m"
            android:text="@string/root_missing"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="#FFD54F"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReboot"
            style="?attr/materialButtonTonalStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_l"
            android:text="@string/reboot_now" />
    </LinearLayout>
</LinearLayout>
