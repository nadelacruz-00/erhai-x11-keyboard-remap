<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Pad3 Kb Remap</string>
    <string name="xposed_desc">Per-app keyboard remapper for the OnePlus Pad 3 official keyboard. Frees the Meta/Super key from Oplus\'s draw-mode gesture, turns Esc into a real Escape, and maps the top row to F1-F12 behind an Fn key (the Search key).</string>

    <!-- settings screen -->
    <string name="title">Pad3 Kb Remap</string>
    <string name="state_loading">……</string>
    <string name="section_behaviour">Behaviour</string>
    <string name="section_apps">Apps that get Super</string>

    <string name="switch_meta">Super key routing</string>
    <string name="switch_meta_sub">Deliver the bot/AI key as a real Meta/Super to the ticked apps</string>
    <string name="switch_search">Block the Search key</string>
    <string name="switch_search_sub">The Search key is the Fn modifier; it stays blocked everywhere</string>
    <string name="switch_fn">Fn restores the top row</string>
    <string name="switch_fn_sub">Hold Search + a top-row key to get its original action (brightness, media, volume)</string>
    <string name="switch_normal">Normal mode for other apps</string>
    <string name="switch_normal_sub">Apps that are not ticked get the keyboard\'s original behaviour back — Esc = Back, top row = brightness / media / volume</string>
    <string name="switch_log">Log every key</string>
    <string name="switch_log_sub">Diagnostic only; leave off for normal use</string>

    <string name="search_hint">Search apps…</string>
    <string name="restore_defaults">Restore defaults</string>

    <!--
      Named for its consequence rather than "kill switch": the UX review flagged a vague
      destructive button sitting next to ordinary controls as a hazard. It also now asks for
      confirmation, and the safe choice is the default.
    -->
    <string name="kill_switch_short">Disable everything</string>
    <string name="kill_switch_title">Disable all remapping?</string>
    <string name="kill_switch_body">Turns off Super-key routing, Search blocking, Fn restore and normal mode. The keyboard goes back to its stock behaviour until you switch something on again. Your app list is kept.</string>
    <string name="kill_switch_confirm">Disable</string>
    <string name="cancel">Cancel</string>
    <string name="kill_switch_done">All remapping is off</string>
    <string name="defaults_done">Defaults restored</string>

    <string name="no_apps_match">No apps match “%1$s”</string>
    <string name="no_apps_installed">No launchable apps found</string>
    <string name="clear_search">Clear search</string>
    <string name="perm_warning">Not granted WRITE_SECURE_SETTINGS — changes cannot be saved.\nRun once:  pm grant com.minis.kbremap android.permission.WRITE_SECURE_SETTINGS</string>
    <string name="no_apps">No apps match</string>
